# 复制本文件为 .env 并填入你的 Key（.env 已被 .gitignore 忽略，不会提交）
# 获取 Key：https://platform.deepseek.com → API Keys → 创建

DEEPSEEK_API_KEY=sk-在这里粘贴你的key

# 以下均为可选，不填用默认值：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=30

# ===== 省钱方案：本地免费生成（需已装 Ollama + 已 pull 模型）=====
# 打开下面两行，生成将走本机 Ollama，不消耗 API 额度：
# LLM_BACKEND=ollama
# LLM_MODEL=qwen2.5:3b

# 想切回云端：把 LLM_BACKEND 改为 deepseek（或删掉该行）

# ===== 联网增强（可选，生成前抓热点/参考）=====
# WEB_SEARCH_ENABLED=1
# WEB_SEARCH_BACKEND=bing        # bing(免Key) / bocha(需BOCHA_API_KEY) / tavily(需TAVILY_API_KEY)
# BOCHA_API_KEY=你的key
# TAVILY_API_KEY=你的key

# ===== 封面增强（可选）=====
# COVER_STYLE=premium     # premium(高级暗调,默认)/minimal(留白极简)/gradient/split/card
# COVER_AI_ENABLED=1
# SILICONFLOW_API_KEY=你的key   # AI背景生成（SiliconFlow，免费额度）
# COVER_AI_MODEL=black-forest-labs/FLUX.1-schnell
