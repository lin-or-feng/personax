# 复制本文件为 .env 并填入你的 Key（.env 已被 .gitignore 忽略，不会提交）
# 获取 Key：https://platform.deepseek.com → API Keys → 创建

DEEPSEEK_API_KEY=sk-在这里粘贴你的key

# 以下均为可选，不填用默认值：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=30

# ===== 省钱方案：本地免费生成（需已装 Ollama + 已 pull 模型）=====
# 打开下面两行，生成将走本机 Ollama，不消耗 API 额度：
# LLM_BACKEND=ollama
# LLM_MODEL=qwen2.5:3b

# 想切回云端：把 LLM_BACKEND 改为 deepseek（或删掉该行）

# ===== LLM 双重限流（可选） =====
# Semaphore 控制同时在途数：本地 Ollama 默认 1，DeepSeek 云端默认 2。
# 滑动窗口控制请求启动频率：同步/异步入口共享，默认 60 次/分钟。
# 4060 Ti 单卡提高到 2/4 通常不会降低单请求延迟；云端批处理可从 2 开始压测。
# LLM_MAX_CONCURRENCY=2
# LLM_REQUESTS_PER_MINUTE=60

# ===== 真实发布安全锁（默认关闭） =====
# 调试、账号受限或验收阶段请保持 0；此时只能生成、预览和干跑。
# 确认账号恢复且准备真实发布时，改为 1 并重启命令行 / Streamlit：
# XHS_REAL_PUBLISH_ENABLED=0

# ===== 联网增强（可选，生成前抓热点/参考）=====
# WEB_SEARCH_ENABLED=1
# WEB_SEARCH_BACKEND=bing        # bing(免Key) / bocha(需BOCHA_API_KEY) / tavily(需TAVILY_API_KEY)
# WEB_SEARCH_REQUESTS_PER_MINUTE=10
# WEB_SEARCH_MAX_CONCURRENCY=2    # 可选增强，忙时快速降级为空，不阻塞正文生成
# BOCHA_API_KEY=你的key
# TAVILY_API_KEY=你的key

# ===== RAG 混合检索（可选） =====
# 默认 hashing 只用于离线测试。真实语义向量推荐本地 Ollama：
# RAG_EMBEDDING_BACKEND=ollama
# RAG_EMBEDDING_MODEL=bge-m3       # 先执行 ollama pull bge-m3
# RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434  # 通常无需设置；原生 embed API 地址
# RAG_EMBEDDING_CACHE=1            # 文档向量持久化，重启不重算
# RAG_EMBEDDING_CACHE_PATH=D:\deepseekworkspace\personax_project\.rag_cache\embeddings.sqlite3
# RAG_RETRIEVAL_MODE=hybrid        # bm25 / dense / hybrid；默认混合检索
# RAG_QUERY_ENHANCER=rule          # rule / llm
# RAG_ENABLE_HYDE=0                # 设 1 会额外调用一次 LLM
# Cross-encoder 需先安装: pip install -e ".[rag]"
# RAG_RERANKER=none                # none / cross-encoder
# RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# ===== Docker Compose（可选） =====
# Docker 默认离线模板；以下变量用于切换后端和宿主机端口。
# PERSONAX_BIND_HOST=127.0.0.1
# PERSONAX_PORT=8501
# LLM_BACKEND=ollama
# PERSONAX_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# PERSONAX_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# PersonaX 没有内置登录鉴权；不要把 8501 或 Ollama 11434 直接暴露到公网。

# ===== AI 助手路由（主配置位于 config/persona.yaml）=====
# assistant.router=rule 是默认低延迟方案。如需 LLM 结构化判断，将 persona.yaml 中该值改为 llm。
# assistant.tool_runtime=langchain 使用 StructuredTool；native 则直接调用同一安全网关。

# ===== 封面增强（可选）=====
# COVER_STYLE=premium     # premium(高级暗调,默认)/minimal(留白极简)/gradient/split/card
# COVER_AI_ENABLED=1
# SILICONFLOW_API_KEY=你的key   # AI背景生成（SiliconFlow，免费额度）
# COVER_AI_MODEL=black-forest-labs/FLUX.1-schnell
